# Copy to .env and fill in real values. Never commit .env.

# Neon: use the pooled connection here, and the direct (non-pooled) connection below.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Generate with: npx auth secret
AUTH_SECRET=""
AUTH_TRUST_HOST="true"
# Production only, for example https://ojoma.vercel.app
AUTH_URL="http://localhost:3000"

# Used once by prisma db seed. Not hardcoded in the app.
ADMIN_EMAIL="owner@example.com"
ADMIN_PASSWORD="change-me-please"

# Paystack secret key. The public key is not required for the redirect flow.
PAYSTACK_SECRET_KEY=""

# Unsigned upload preset. The Cloudinary API secret stays in the Cloudinary dashboard
# and is never sent to the browser. The upload route checks the admin session first.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_UPLOAD_PRESET=""

RESEND_API_KEY=""
EMAIL_FROM="Aurane <orders@yourdomain.com>"

# Optional. Bulk SMS uses Termii when both are set. Email campaigns work without them.
TERMII_API_KEY=""
TERMII_SENDER_ID=""

# Public site URL used for links, Paystack callbacks, sitemap, and Open Graph.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
